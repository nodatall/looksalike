# Local-only secret. Normal checks never need an API key.
SERPAPI_API_KEY=
LIVE_SEARCH_ENABLED=false

# Planned live-search limits; wiring follows the feasibility experiment.
SEARCH_DAILY_ATTEMPT_LIMIT=10
SEARCH_ROLLING_30_DAY_ATTEMPT_LIMIT=180
SEARCH_VISITOR_HOURLY_LIMIT=3
SEARCH_DEADLINE_SECONDS=55

# Rails/Puma settings.
PORT=3000
RAILS_MAX_THREADS=3
# Set SECRET_KEY_BASE through the hosting service in production.
# SECRET_KEY_BASE=
